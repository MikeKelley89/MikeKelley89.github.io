---
import '../styles/global.css';
import OnThisPage from '../components/OnThisPage.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Technical writing, documentation engineering, and docs-as-code portfolio.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#142b4a" />
    <title>{title}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/themes/prism-tomorrow.min.css" />
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/prism-core.min.js"></script>
    <script is:inline defer src="https://cdn.jsdelivr.net/npm/prismjs@1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        if (window.Prism) {
          window.Prism.plugins.autoloader.languages_path =
            'https://cdn.jsdelivr.net/npm/prismjs@1.29.0/components/';
          window.Prism.highlightAll();
        }
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href={base}>Mike Kelley <span aria-hidden="true">/</span> Technical Documentation</a>
      <nav aria-label="Main navigation">
        <a href={base} aria-current={currentPath === base ? 'page' : undefined}>Home</a>
        <a href={`${base}writing/`} aria-current={currentPath === `${base}writing/` || currentPath === `${base}writing` ? 'page' : undefined}>Writing Samples</a>
        <a href={`${base}docs-as-code/`} aria-current={currentPath === `${base}docs-as-code/` || currentPath === `${base}docs-as-code` ? 'page' : undefined}>Docs-as-Code</a>
        <a href={`${base}demos/`} aria-current={currentPath === `${base}demos/` || currentPath === `${base}demos` ? 'page' : undefined}>Code Demos</a>
        <a href={`${base}resume/`}>Resume</a>
      </nav>
    </header>
    <main id="main" class="page-with-toc">
      <div id="page-content"><slot /></div>
      <OnThisPage />
    </main>
    <footer class="site-footer wrap">
      <span>Mike Kelley · Technical Writing & Documentation Engineering</span>
      <span>Built with Astro</span>
    </footer>
  </body>
</html>
